{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "pretty": true,
    "strict": true,
    "checkJs": true,
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@intercom/intercom-react-native/lib/typescript/module/expo-plugins/@types": ["./node_modules/@intercom/intercom-react-native/lib/typescript/module/expo-plugins/@types.d.ts"],
      "expo-build-properties/build/pluginConfig": ["./node_modules/expo-build-properties/build/pluginConfig.d.ts"],
      "expo-font/plugin/build/withFonts": ["./node_modules/expo-font/plugin/build/withFonts.d.ts"],
      "react-native-reanimated-carousel": ["./node_modules/react-native-reanimated-carousel/lib/typescript/module/index.d.ts"]
    }
  },
  "include": [
    "*.config.ts",
    "*.config.js",
    "*.config.cjs",
    "*.config.mjs",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/index.js"
  ]
}
