{
  "name": "@exactly/e2e",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "test": "nx test e2e",
    "test:ts": "tsc --pretty ${GITHUB_ACTIONS:+false}",
    "maestro": "hash=$(cat package.json patches/*.patch | git hash-object --stdin) && echo $hash | cmp -s - build/hash || { src=$(mktemp -d) && trap 'rm -rf $src' EXIT && git init -q $src && git -C $src fetch -q --depth 1 https://github.com/mobile-dev-inc/Maestro cli-2.11.0 && git -C $src checkout -q FETCH_HEAD && git -C $src apply $PWD/patches/*.patch && $src/gradlew -p $src :maestro-cli:installDist -x :maestro-ios-driver:buildIosDriver && rm -rf build && mv $src/maestro-cli/build/install/maestro build && echo $hash > build/hash; }",
    "vault": "src=$(mktemp -d) && trap 'rm -rf $src' EXIT && git init -q $src && git -C $src fetch -q --depth 1 https://github.com/android/identity-samples 807e7c2402e66bfc8151d4608e6ddd7ec2e0aebb && git -C $src checkout -q FETCH_HEAD && $src/CredentialProvider/MyVault/gradlew -p $src/CredentialProvider/MyVault :app:assembleDebug && mv $src/CredentialProvider/MyVault/app/build/outputs/apk/debug/app-debug.apk vault.apk",
    "dev": "nx dev e2e"
  },
  "engines": {
    "node": "^24.14.1"
  },
  "devDependencies": {
    "@exactly/common": "workspace:^0.0.22",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "esbuild": "^0.28.1",
    "eslint": "catalog:",
    "fast-text-encoding": "^1.0.6",
    "typescript": "catalog:",
    "viem": "catalog:"
  },
  "nx": {
    "projectType": "library",
    "namedInputs": {
      "bundle": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/maestro.d.ts",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/esbuild.config.cjs",
        "sharedGlobals"
      ]
    },
    "targets": {
      "prepare": {
        "dependsOn": [
          "^prepare",
          "build"
        ],
        "executor": "nx:noop"
      },
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "inputs": [
          "bundle",
          {
            "dependentTasksOutputFiles": "common/generated/**/*",
            "transitive": true
          },
          "^production"
        ],
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "minify": true,
          "thirdParty": true,
          "outputPath": ".maestro/dist",
          "platform": "neutral",
          "tsConfig": "{projectRoot}/tsconfig.json",
          "esbuildConfig": "{projectRoot}/esbuild.config.cjs",
          "main": "{projectRoot}/src/script/*.ts"
        }
      },
      "dev": {
        "continuous": true,
        "dependsOn": [
          "^prepare",
          "^build"
        ],
        "executor": "@nx/esbuild:esbuild",
        "inputs": [
          "bundle",
          "^production"
        ],
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "watch": true,
          "thirdParty": true,
          "outputPath": ".maestro/dist",
          "platform": "neutral",
          "tsConfig": "{projectRoot}/tsconfig.json",
          "esbuildConfig": "{projectRoot}/esbuild.config.cjs",
          "main": "{projectRoot}/src/script/*.ts"
        }
      },
      "test": {
        "dependsOn": [
          "test:eslint",
          "test:ts"
        ],
        "executor": "nx:noop"
      }
    }
  },
  "private": true
}
