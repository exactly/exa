+    private suspend fun DefaultClientWebSocketSession.evaluateInWorld(targetId: String, exprJson: String, deadline: Long, isReplaced: (String) -> Boolean): String? {
+        val uniqueId = worlds.remove(targetId) ?: return null
+        val messageId = idCounter.getAndIncrement()
+        send(Frame.Text("""{"id":$messageId,${evaluateParams(exprJson, uniqueId)}}"""))
+        val text = waitForMessage(messageId, deadline - System.currentTimeMillis())
+        if (isReplaced(text)) return null
+        worlds[targetId] = uniqueId
+        return text
+    }
+
+    private suspend fun DefaultClientWebSocketSession.evaluateInNewWorld(targetId: String, exprJson: String, deadline: Long, isReplaced: (String) -> Boolean): String {
+        val contexts = mutableMapOf<String, String>()
+        var documents = 0
+        var replaced = 0
+        suspend fun next(): JsonObject {
+            val frame = incoming.receive() as? Frame.Text ?: return JsonObject(emptyMap())
+            val message = json.parseToJsonElement(frame.readText()).jsonObject
+            if (message["method"]?.jsonPrimitive?.content != "Runtime.executionContextCreated") return message
+            val context = message["params"]?.jsonObject?.get("context")?.jsonObject ?: return message
+            if (context["auxData"]?.jsonObject?.get("isDefault")?.jsonPrimitive?.content == "true") documents++
+            if (context["name"]?.jsonPrimitive?.content == "maestro") {
+                contexts[context.getValue("id").jsonPrimitive.content] = context.getValue("uniqueId").jsonPrimitive.content
+            }
+            return message
+        }
+        suspend fun call(payload: String): JsonObject {
+            val messageId = idCounter.getAndIncrement()
+            send(Frame.Text("""{"id":$messageId,$payload}"""))
+            while (true) next().takeIf { it["id"]?.jsonPrimitive?.content == "$messageId" }?.let { return it }
+        }
+        suspend fun createWorld(frameId: String) = call(""""method":"Page.createIsolatedWorld","params":{"frameId":"$frameId","worldName":"maestro"}""")
+            .get("result")?.jsonObject?.get("executionContextId")?.jsonPrimitive?.content
+        try {
+            return withTimeoutOrNull(deadline - System.currentTimeMillis()) {
+                call(""""method":"Runtime.enable"""")
+                var reply: String? = null
+                while (reply == null) {
+                    val seen = documents
+                    val contextId = createWorld(frames[targetId] ?: targetId) ?: run {
+                        val frameTree = call(""""method":"Page.getFrameTree"""")["result"]?.jsonObject?.get("frameTree")?.jsonObject
+                        val frameId = frameTree?.get("frame")?.jsonObject?.get("id")?.jsonPrimitive?.content ?: error("Could not find the main frame of $targetId")
+                        frames[targetId] = frameId
+                        createWorld(frameId) ?: error("Could not create an isolated world on $frameId")
+                    }
+                    val uniqueId = contexts[contextId]
+                    val text = uniqueId?.let { call(evaluateParams(exprJson, it)).toString() }
+                    if (uniqueId != null && text != null && !isReplaced(text)) {
+                        worlds[targetId] = uniqueId
+                        reply = text
+                    }
+                    if (reply == null) {
+                        replaced++
+                        while (documents == seen) next()
+                    }
+                }
+                call(""""method":"Runtime.disable"""")
+                reply
+            } ?: error("No reply from $targetId within ${CDP_RESPONSE_TIMEOUT_MS}ms" + if (replaced > 0) " after $replaced replaced documents" else "")
+        } catch (e: Exception) {
+            cancel()
+            throw e
+        }
+    }
+
+    private fun evaluateParams(exprJson: String, uniqueId: String) =
+        """"method":"Runtime.evaluate","params":{"expression":$exprJson,"awaitPromise":true,"uniqueContextId":${Json.encodeToString(JsonPrimitive(uniqueId))}}"""
+
