+    private suspend fun DefaultClientWebSocketSession.evaluateInWorld(frameId: String, exprJson: String): String? {
+        val worldId = idCounter.getAndIncrement()
+        send(Frame.Text("""{"id":$worldId,"method":"Page.createIsolatedWorld","params":{"frameId":"$frameId","worldName":"maestro"}}"""))
+        val contextId = json.parseToJsonElement(waitForMessage(worldId)).jsonObject["result"]
+            ?.jsonObject?.get("executionContextId")?.jsonPrimitive?.content
+            ?: error("Could not create an isolated world on $frameId")
+        val uniqueId = worlds[frameId]?.takeIf { it.first == contextId }?.second
+            ?: findWorld(frameId, contextId)?.also { worlds[frameId] = contextId to it }
+            ?: return null
+        val messageId = idCounter.getAndIncrement()
+        val payload = """
+            {
+                "id":$messageId,
+                "method":"Runtime.evaluate",
+                "params":{"expression":$exprJson,"awaitPromise":true,"uniqueContextId":${Json.encodeToString(JsonPrimitive(uniqueId))}}
+            }
+        """.trimIndent()
+        send(Frame.Text(payload))
+        val text = waitForMessage(messageId)
+        if (json.parseToJsonElement(text).jsonObject["error"]?.jsonObject?.get("message")?.jsonPrimitive?.content !in CONTEXT_REPLACED) return text
+        worlds.remove(frameId)
+        return null
+    }
+
+    private suspend fun DefaultClientWebSocketSession.findWorld(frameId: String, contextId: String): String? {
+        var uniqueId: String? = null
+        try {
+            val enableId = idCounter.getAndIncrement()
+            send(Frame.Text("""{"id":$enableId,"method":"Runtime.enable"}"""))
+            withTimeoutOrNull(CDP_RESPONSE_TIMEOUT_MS) {
+                for (frame in incoming) {
+                    if (frame !is Frame.Text) continue
+                    val message = json.parseToJsonElement(frame.readText()).jsonObject
+                    if (message["id"]?.jsonPrimitive?.content == "$enableId") return@withTimeoutOrNull true
+                    if (message["method"]?.jsonPrimitive?.content != "Runtime.executionContextCreated") continue
+                    val context = message["params"]?.jsonObject?.get("context")?.jsonObject ?: continue
+                    if (context["id"]?.jsonPrimitive?.content == contextId &&
+                        context["name"]?.jsonPrimitive?.content == "maestro" &&
+                        context["auxData"]?.jsonObject?.get("frameId")?.jsonPrimitive?.content == frameId
+                    ) uniqueId = context["uniqueId"]?.jsonPrimitive?.content
+                }
+                null
+            } ?: error("No message with id $enableId received within ${CDP_RESPONSE_TIMEOUT_MS}ms")
+            val disableId = idCounter.getAndIncrement()
+            send(Frame.Text("""{"id":$disableId,"method":"Runtime.disable"}"""))
+            waitForMessage(disableId)
+        } catch (e: Exception) {
+            cancel()
+            throw e
+        }
+        return uniqueId
+    }
+
+    private suspend fun DefaultClientWebSocketSession.waitForDocument(frameId: String) {
+        val enableId = idCounter.getAndIncrement()
+        send(Frame.Text("""{"id":$enableId,"method":"Runtime.enable"}"""))
+        var replaced = false
+        for (frame in incoming) {
+            if (frame !is Frame.Text) continue
+            val message = json.parseToJsonElement(frame.readText()).jsonObject
+            if (message["method"]?.jsonPrimitive?.content != "Runtime.executionContextCreated") continue
+            val auxData = message["params"]?.jsonObject?.get("context")?.jsonObject?.get("auxData")?.jsonObject ?: continue
+            if (auxData["frameId"]?.jsonPrimitive?.content == frameId && auxData["isDefault"]?.jsonPrimitive?.content == "true") {
+                replaced = true
+                break
+            }
+        }
+        check(replaced) { "The session on $frameId closed before a document replaced the one that navigated" }
+        val disableId = idCounter.getAndIncrement()
+        send(Frame.Text("""{"id":$disableId,"method":"Runtime.disable"}"""))
+        waitForMessage(disableId)
+    }
+
