-            is TapOnElementCommand -> {
+            is TapOnElementCommand -> aimAgainOnScreenChange(command.waitToSettleTimeoutMs) {
                 tapOnElement(
                     command = command,
                     retryIfNoChange = command.retryIfNoChange ?: false,
@@ -444,8 +444,8 @@ class Orchestra(
                 )
             }
 
-            is TapOnPointCommand -> tapOnPoint(command, command.retryIfNoChange ?: false)
-            is TapOnPointV2Command -> tapOnPointV2Command(command)
+            is TapOnPointCommand -> aimAgainOnScreenChange(null) { tapOnPoint(command, command.retryIfNoChange ?: false) }
+            is TapOnPointV2Command -> aimAgainOnScreenChange(command.waitToSettleTimeoutMs) { tapOnPointV2Command(command) }
             is BackPressCommand -> backPressCommand()
             is HideKeyboardCommand -> hideKeyboardCommand()
             is ScrollCommand -> scrollVerticalCommand()
@@ -1442,6 +1442,21 @@ class Orchestra(
         return true
     }
 
+    private suspend fun aimAgainOnScreenChange(waitToSettleTimeoutMs: Int?, tap: suspend () -> Boolean): Boolean {
+        var deadline: Long? = null
+        while (true) {
+            try {
+                return tap()
+            } catch (e: MaestroException.ScreenChanged) {
+                val now = System.currentTimeMillis()
+                val end = deadline ?: (now + (waitToSettleTimeoutMs?.toLong() ?: SCREEN_CHANGE_TIMEOUT_MS)).also { deadline = it }
+                if (now >= end) throw e
+                logger.info("Tap aimed again: the screen changed after it settled")
+                maestro.waitForAppToSettle(waitToSettleTimeoutMs = waitToSettleTimeoutMs)
+            }
+        }
+    }
+
     private suspend fun tapOnPoint(
         command: TapOnPointCommand,
         retryIfNoChange: Boolean,
@@ -1920,6 +1935,7 @@ class Orchestra(
 
         private const val MAX_ERASE_CHARACTERS = 50
         private const val MAX_RETRIES_ALLOWED = 3
+        private const val SCREEN_CHANGE_TIMEOUT_MS = 3000L
         private val logger = LoggerFactory.getLogger(Orchestra::class.java)
     }
 
