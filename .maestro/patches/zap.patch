@@ -285,10 +286,6 @@ class CdpWebDriver(
 
     private fun scrollToPoint(point: Point): Long {
         ensureOpen()
-        val windowHeight = executeJS("window.innerHeight") as Int
-
-        if (point.y >= 0 && point.y.toLong() <= windowHeight) return 0L
-
         val scrolledPixels =
             executeJS("(() => {const delta = ${point.y} - Math.floor(window.innerHeight / 2); window.scrollBy({ top: delta, left: 0, behavior: 'smooth' }); return delta})()") as Int
         sleep(3000L)
@@ -552,20 +549,34 @@ class CdpWebDriver(
             return
         }
 
-        val pixelsScrolled = scrollToPoint(point)
+        val guarding = settledForTap
+        settledForTap = false
+        val guard = if (guarding) "(window.maestro.guard ? window.maestro.guard(${point.x}, ${point.y}, true) : true)" else "true"
+        val inView = executeJS("${point.y} <= window.innerHeight ? $guard : 'scroll'")
+            ?: throw IllegalStateException("Failed to read the page before tapping at $point")
+        if (inView == false) throw MaestroException.ScreenChanged()
+        val pixelsScrolled = if (inView == "scroll") scrollToPoint(point) else 0L
+        val y = point.y - pixelsScrolled.toInt()
+        if (guarding && inView == "scroll") executeJS("window.maestro.guard?.(${point.x}, $y, false)")
 
-        dispatchInputEvents(
-            "Input.dispatchMouseEvent",
-            listOf("mouseMoved", "mousePressed", "mouseReleased").map { type ->
-                mapOf(
-                    "type" to type,
-                    "x" to point.x,
-                    "y" to point.y - pixelsScrolled.toInt(),
-                    "button" to if (type == "mouseMoved") "none" else "left",
-                    "clickCount" to 1,
-                )
-            },
-        )
+        try {
+            dispatchInputEvents(
+                "Input.dispatchMouseEvent",
+                listOf("mouseMoved", "mousePressed", "mouseReleased").map { type ->
+                    mapOf(
+                        "type" to type,
+                        "x" to point.x,
+                        "y" to y,
+                        "button" to if (type == "mouseMoved") "none" else "left",
+                        "clickCount" to 1,
+                    )
+                },
+            )
+        } catch (e: Exception) {
+            if (guarding) runCatching { executeJS("window.maestro.unguard?.()") }
+            throw e
+        }
+        if (guarding && executeJS("window.maestro.unguard ? window.maestro.unguard() : false") == true) throw MaestroException.ScreenChanged()
     }
 
     private fun dispatchInputEvents(method: String, events: List<Map<String, Any>>) {
@@ -851,6 +862,7 @@ class CdpWebDriver(
     }
 
     override fun waitForAppToSettle(initialHierarchy: ViewHierarchy?, appId: String?, timeoutMs: Int?): ViewHierarchy? {
+        settledForTap = true
         val deadline = System.currentTimeMillis() + (timeoutMs ?: SETTLE_TIMEOUT_MS)
         while (true) {
             detectWindowChange()
diff --git a/maestro-client/src/main/resources/maestro-web.js b/maestro-client/src/main/resources/maestro-web.js
index 81ba56d..8c53726 100644
--- a/maestro-client/src/main/resources/maestro-web.js
+++ b/maestro-client/src/main/resources/maestro-web.js
@@ -288,6 +288,32 @@
         setTimeout(check, quietMs)
     })
 
+    maestro.guard = (x, y, checkMoved) => {
+        maestro.unguard?.()
+        if (checkMoved && maestro.moved?.()) return false
+        const expected = document.elementFromPoint(x, y)
+        const types = ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click']
+        let pressed = false
+        let blocked = false
+        const block = event => {
+            if (!pressed) {
+                pressed = true
+                blocked = expected !== null && event.target !== expected
+            }
+            if (blocked) {
+                event.preventDefault()
+                event.stopImmediatePropagation()
+            }
+        }
+        types.forEach(type => window.addEventListener(type, block, true))
+        maestro.unguard = () => {
+            types.forEach(type => window.removeEventListener(type, block, true))
+            maestro.unguard = undefined
+            return blocked
+        }
+        return true
+    }
+
     // Replacer for JSON.stringify of the snapshot. A live DOM node can leak in and, on some frameworks,
     // carry back-references (node -> ... -> node), so stringify throws "Converting circular structure to
     // JSON" and the whole capture fails. Drop DOM nodes and break cycles so serialization always completes.
diff --git a/maestro-orchestra/src/main/java/maestro/orchestra/Orchestra.kt b/maestro-orchestra/src/main/java/maestro/orchestra/Orchestra.kt
