+    override fun enrollBiometrics() {
+        LOGGER.warn("Enrolling biometrics is not available on Android, enroll a fingerprint in the emulator's settings instead")
+    }
+
+    override fun matchBiometrics() {
+        metrics.measured("operation", mapOf("command" to "matchBiometrics")) {
+            val listening = MaestroTimer.withTimeout(BIOMETRICS_TIMEOUT_MS) {
+                fingerprintEvents().lastOrNull()?.takeIf { (_, message) -> FINGERPRINT_LISTENING.containsMatchIn(message) }
+            } ?: throw IllegalStateException("No fingerprint operation is waiting for a touch on ${connection.serial}")
+            val process = ProcessBuilder("adb", "-s", connection.serial, "emu", "finger", "touch", "1")
+                .redirectErrorStream(true)
+                .start()
+            if (!process.waitFor(1, TimeUnit.MINUTES)) {
+                throw TimeoutException("Matching biometrics on ${connection.serial} timed out")
+            }
+            if (process.exitValue() != 0) {
+                throw IllegalStateException("Failed to match biometrics on ${connection.serial}: ${process.inputStream.bufferedReader().readText()}")
+            }
+            MaestroTimer.withTimeout(BIOMETRICS_TIMEOUT_MS) {
+                fingerprintEvents().firstOrNull { (time, message) -> time > listening.first && "onAcquired(" in message }
+            } ?: throw IllegalStateException("Fingerprint touch was not acquired on ${connection.serial}")
+        }
+    }
+
+    private fun fingerprintEvents() = shell("logcat -d -v epoch -s fingerprint-service.ranchu").lines().mapNotNull { line ->
+        val fields = line.trim().split(Regex("\\s+"), limit = 6)
+        fields.getOrNull(5)?.let { message -> fields[0].toBigDecimalOrNull()?.let { time -> time to message } }
+    }
+
