+    fun enrollBiometrics(deviceId: String) {
+        biometricLogs.getOrPut(deviceId) { BiometricLog(deviceId) }
+        notifyutil(deviceId, "-s", "com.apple.BiometricKit.enrollmentChanged", "1")
+        notifyutil(deviceId, "-p", "com.apple.BiometricKit.enrollmentChanged")
+    }
+
+    fun matchBiometrics(deviceId: String) {
+        val log = biometricLogs[deviceId] ?: throw SimctlError("Biometrics are not enrolled on $deviceId")
+        if (log.latest() != BIOMETRICS_STARTED && !log.next { it == BIOMETRICS_STARTED }) {
+            throw SimctlError("No biometric operation is waiting for a match on $deviceId")
+        }
+        notifyutil(deviceId, "-p", "com.apple.BiometricKit_Sim.fingerTouch.match")
+        if (!log.next { it.startsWith(BIOMETRICS_MATCHED) }) throw SimctlError("Biometric match was not simulated on $deviceId")
+    }
+
+    private class BiometricLog(deviceId: String) {
+        private val process = ProcessBuilder(
+            "xcrun", "simctl", "spawn", deviceId, "log", "stream", "--style", "ndjson", "--predicate", BIOMETRICS_PREDICATE,
+        ).redirectError(ProcessBuilder.Redirect.DISCARD).start()
+        private val events = LinkedBlockingQueue<String>()
+
+        init {
+            Runtime.getRuntime().addShutdownHook(Thread(process::destroy))
+            val lines = process.inputStream.bufferedReader()
+            lines.readLine() ?: throw SimctlError("Failed to stream the biometric log of $deviceId")
+            thread(isDaemon = true) {
+                lines.forEachLine { line ->
+                    val message = runCatching { jacksonObjectMapper().readValue<Map<String, Any?>>(line)["eventMessage"] as? String }.getOrNull()
+                    if (message == BIOMETRICS_STARTED || message == BIOMETRICS_CANCELED || message?.startsWith(BIOMETRICS_MATCHED) == true) events.put(message)
+                }
+            }
+        }
+
+        fun latest(): String? = generateSequence { events.poll() }.lastOrNull()
+
+        fun next(until: (String) -> Boolean): Boolean {
+            val deadline = System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(BIOMETRICS_TIMEOUT_MS)
+            while (true) {
+                val event = events.poll(deadline - System.nanoTime(), TimeUnit.NANOSECONDS) ?: return false
+                if (until(event)) return true
+            }
+        }
+    }
+
+    private fun notifyutil(deviceId: String, vararg arguments: String) {
+        runCommand(listOf("xcrun", "simctl", "spawn", deviceId, "notifyutil", *arguments))
+    }
+
