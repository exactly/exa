From 4a7201ecdabb0211d758d7d5557567dd8936fff1 Mon Sep 17 00:00:00 2001
From: danilo neves cruz <cruzdanilo@gmail.com>
Date: Thu, 19 Nov 2026 23:54:24 +0000
Subject: [PATCH] fix: hold iOS taps for 50 ms

Every iOS tap holds the finger down for 100 ms before lifting it, which is longer than a person's tap and adds to every tap a flow makes. Holding for 50 ms still registers as a tap in UIKit and React Native, and swipes keep their 100 ms start.
---
 .../maestro-driver-iosUITests/Routes/XCTest/EventRecord.swift  | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/XCTest/EventRecord.swift b/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/XCTest/EventRecord.swift
index b743739..6abbd99 100644
--- a/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/XCTest/EventRecord.swift
+++ b/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/XCTest/EventRecord.swift
@@ -5,6 +5,7 @@ import UIKit
 final class EventRecord: NSObject {
     let eventRecord: NSObject
     static let defaultTapDuration = 0.1
+    static let tapDuration = 0.05
 
     enum Style: String {
         case singeFinger = "Single-Finger Touch Action"
@@ -23,7 +24,7 @@ final class EventRecord: NSObject {
 
     func addPointerTouchEvent(at point: CGPoint, touchUpAfter: TimeInterval?) -> Self {
         var path = PointerEventPath.pathForTouch(at: point)
-        path.offset += touchUpAfter ?? Self.defaultTapDuration
+        path.offset += touchUpAfter ?? Self.tapDuration
         path.liftUp()
         return add(path)
     }
