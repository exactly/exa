-    override fun waitForAppToSettle(initialHierarchy: ViewHierarchy?, appId: String?, timeoutMs: Int?): ViewHierarchy {
-        return ScreenshotUtils.waitForAppToSettle(initialHierarchy, this)
+    override fun waitForAppToSettle(initialHierarchy: ViewHierarchy?, appId: String?, timeoutMs: Int?): ViewHierarchy? {
+        val deadline = System.currentTimeMillis() + (timeoutMs ?: SETTLE_TIMEOUT_MS)
+        while (true) {
+            detectWindowChange()
+            val window = currentWindow
+            val remaining = deadline - System.currentTimeMillis()
+            if (remaining <= 0) return ViewHierarchy.from(this, false)
+            val state = executeJS("window.maestro.waitForQuiet($SETTLE_QUIET_MS, $remaining)", awaited = true, retry = false) as? Map<*, *> ?: continue
+            if (state["quiet"] != true) return if (state["scrolling"] == true) null else ViewHierarchy.from(this, false)
+            val iframes = (state["iframes"] as? List<*>).orEmpty().filterIsInstance<Number>()
+            val iframeStates = iframes.mapNotNull { waitForIframeQuiet(it.toInt(), deadline) }
+            val restless = iframeStates.filter { it["quiet"] != true }
+            if (restless.isNotEmpty()) return if (restless.any { it["scrolling"] == true }) null else ViewHierarchy.from(this, false)
+            if (iframeStates.any { it["moved"] == true }) continue
+            detectWindowChange()
+            if (currentWindow != window) continue
+            val hierarchy = ViewHierarchy.from(this, false)
+            if (currentWindow == window && executeJS("window.maestro.moved ? window.maestro.moved() : true") == false) return hierarchy
+        }
+    }
+
+    private fun waitForIframeQuiet(iframeIndex: Int, deadline: Long): Map<*, *>? {
+        val driver = seleniumDriver ?: return null
+        val jsExecutor = driver as? JavascriptExecutor ?: return null
+        val remaining = deadline - System.currentTimeMillis()
+        if (remaining <= 0) return mapOf("quiet" to false)
+        val timeouts = driver.manage().timeouts()
+        var sessionScriptTimeout: Duration? = null
+        return try {
+            sessionScriptTimeout = timeouts.scriptTimeout
+            val iframeElement = jsExecutor.executeScript(
+                "return document.querySelectorAll('iframe')[arguments[0]];",
+                iframeIndex
+            ) as? WebElement ?: return null
+            driver.switchTo().frame(iframeElement)
+            timeouts.scriptTimeout(Duration.ofMillis(remaining))
+            jsExecutor.executeAsyncScript(
+                "$maestroWebScript\nwindow.maestro.waitForQuiet($SETTLE_QUIET_MS, $remaining).then(arguments[arguments.length - 1]);"
+            ) as? Map<*, *>
+        } catch (e: Exception) {
+            LOGGER.warn("Failed to wait for cross-origin iframe $iframeIndex to settle", e)
+            mapOf("quiet" to true, "moved" to true)
+        } finally {
+            try { driver.switchTo().defaultContent() }
+            catch (e: Exception) { LOGGER.warn("Failed to switch back to default content", e) }
+            sessionScriptTimeout?.let {
+                try { timeouts.scriptTimeout(it) }
+                catch (e: Exception) { LOGGER.warn("Failed to restore the script timeout", e) }
+            }
+        }
     }
 
     override fun waitUntilScreenIsStatic(timeoutMs: Long): Boolean {
