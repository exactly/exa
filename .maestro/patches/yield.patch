+    maestro.waitForQuiet = (quietMs, timeoutMs) => new Promise(resolve => {
+        maestro.unwatch?.()
+        maestro.unwatch = maestro.moved = undefined
+        const start = performance.now()
+        let last = start
+        let scrolled = -Infinity
+        let frames = 0
+        let done = false
+        const frame = () => {
+            frames++
+            if (!done) requestAnimationFrame(frame)
+        }
+        requestAnimationFrame(frame)
+        const touch = () => {
+            last = performance.now()
+            frames = 0
+        }
+        const scroll = () => {
+            touch()
+            scrolled = last
+        }
+        const observer = new MutationObserver(records => {
+            if (records.some(record => record.attributeName !== 'cd_frame_id_')) touch()
+        })
+        const watched = new Set()
+        const documents = (doc, found = []) => {
+            found.push(doc)
+            for (const frame of doc.querySelectorAll('iframe')) {
+                try {
+                    if (frame.contentDocument) documents(frame.contentDocument, found)
+                } catch (e) {}
+            }
+            return found
+        }
+        const watch = docs => docs.filter(doc => !watched.has(doc)).forEach(doc => {
+            watched.add(doc)
+            observer.observe(doc, { subtree: true, childList: true, attributes: true, characterData: true })
+            doc.addEventListener('scroll', scroll, { capture: true, passive: true })
+        })
+        const finishing = new WeakSet()
+        const animating = docs => {
+            const running = docs.flatMap(doc => doc.getAnimations()).filter(animation =>
+                animation.playState === 'running' && animation.effect?.getTiming().iterations !== Infinity)
+            running.filter(animation => !finishing.has(animation)).forEach(animation => {
+                finishing.add(animation)
+                animation.finished.then(touch, touch)
+            })
+            return running.length > 0
+        }
+        const check = () => {
+            const docs = documents(document)
+            watch(docs)
+            if (animating(docs)) touch()
+            const now = performance.now()
+            const quiet = now - last >= quietMs && frames >= 2 && docs.every(doc => doc.readyState === 'complete')
+            if (quiet || now - start >= timeoutMs) {
+                done = true
+                const stop = () => {
+                    observer.disconnect()
+                    watched.forEach(doc => doc.removeEventListener('scroll', scroll, { capture: true }))
+                }
+                const iframes = [...document.querySelectorAll('iframe')].flatMap((iframe, index) => {
+                    try { if (iframe.contentDocument) return [] } catch (e) {}
+                    const rect = iframe.getBoundingClientRect()
+                    return iframe.checkVisibility() && rect.bottom > 0 && rect.right > 0 &&
+                        rect.top < innerHeight && rect.left < innerWidth ? [index] : []
+                })
+                if (quiet) {
+                    const settled = last
+                    maestro.unwatch = stop
+                    maestro.moved = () => last > settled || animating(documents(document))
+                } else stop()
+                resolve({ quiet, moved: last > start, scrolling: now - scrolled < quietMs, iframes })
+            } else {
+                setTimeout(check, Math.max(10, quietMs - (now - last)))
+            }
+        }
+        const docs = documents(document)
+        watch(docs)
+        if (animating(docs)) touch()
+        setTimeout(check, quietMs)
+    })
+
+    maestro.smoothScroll = (top, left) => {
+        const scrolled = window.scroll({ top, left, behavior: 'smooth' })
+        if (document.visibilityState !== 'visible') return
+        const stop = new AbortController()
+        let leaving = false
+        window.addEventListener('pagehide', () => { leaving = true }, { signal: stop.signal })
+        const hidden = new Promise(resolve => document.addEventListener('visibilitychange', () => {
+            if (!leaving && document.visibilityState === 'hidden') resolve()
+        }, { signal: stop.signal }))
+        return Promise.race([scrolled, hidden]).finally(() => stop.abort())
+    }
+
     // Replacer for JSON.stringify of the snapshot. A live DOM node can leak in and, on some frameworks,
     // carry back-references (node -> ... -> node), so stringify throws "Converting circular structure to
     // JSON" and the whole capture fails. Drop DOM nodes and break cycles so serialization always completes.
