From 7b4b7fcfb332203e52249a1a6cd1a48b024adb97 Mon Sep 17 00:00:00 2001
From: danilo neves cruz <cruzdanilo@gmail.com>
Date: Wed, 21 Oct 2026 16:27:49 +0000
Subject: [PATCH] fix: scroll web pages with wheel events in scrollUntilVisible

scrollUntilVisible scrolls by swiping from the center of the screen. On web that swipe scrolled the window, which never moves an app that scrolls inside an element, like React Native Web (#1775), and a touch drag doesn't scroll either when the element under the finger handles touches itself (touch-action: none), like a chart. Give drivers a scroll that defaults to the swipe, and scroll web pages with a mouse wheel over the same point, so the browser scrolls whatever is under it, as it does for a user.
---
 .../src/main/java/maestro/Driver.kt           |  2 ++
 .../src/main/java/maestro/Maestro.kt          |  2 +-
 .../main/java/maestro/drivers/CdpWebDriver.kt | 20 +++++++++++++++++++
 3 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/maestro-client/src/main/java/maestro/Driver.kt b/maestro-client/src/main/java/maestro/Driver.kt
index 7c6e2d1..1704bb4 100644
--- a/maestro-client/src/main/java/maestro/Driver.kt
+++ b/maestro-client/src/main/java/maestro/Driver.kt
@@ -66,6 +66,8 @@ interface Driver {
 
     fun swipe(elementPoint: Point, direction: SwipeDirection, durationMs: Long)
 
+    fun scroll(from: Point, direction: SwipeDirection, durationMs: Long) = swipe(from, direction, durationMs)
+
     fun backPress()
 
     fun inputText(text: String)
diff --git a/maestro-client/src/main/java/maestro/Maestro.kt b/maestro-client/src/main/java/maestro/Maestro.kt
index 259c5e4..45d3d33 100644
--- a/maestro-client/src/main/java/maestro/Maestro.kt
+++ b/maestro-client/src/main/java/maestro/Maestro.kt
@@ -205,7 +205,7 @@ class Maestro(
 
         LOGGER.info("Swiping ${swipeDirection.name} from center")
         val center = Point(x = deviceInfo.widthGrid / 2, y = deviceInfo.heightGrid / 2)
-        runInterruptible(Dispatchers.IO) { driver.swipe(center, swipeDirection, durationMs) }
+        runInterruptible(Dispatchers.IO) { driver.scroll(center, swipeDirection, durationMs) }
         recentScroll = true
         waitForAppToSettle(waitToSettleTimeoutMs = waitToSettleTimeoutMs)
     }
diff --git a/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt b/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt
index 421bbda..b1492ad 100644
--- a/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt
+++ b/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt
@@ -585,6 +585,26 @@ class CdpWebDriver(
         }
     }
 
+    override fun scroll(from: Point, direction: SwipeDirection, durationMs: Long) {
+        val deviceInfo = deviceInfo()
+        val (deltaX, deltaY) = when (direction) {
+            SwipeDirection.UP -> 0 to from.y - (deviceInfo.heightGrid * 0.1f).toInt()
+            SwipeDirection.DOWN -> 0 to from.y - (deviceInfo.heightGrid * 0.9f).toInt()
+            SwipeDirection.LEFT -> from.x - (deviceInfo.widthGrid * 0.1f).toInt() to 0
+            SwipeDirection.RIGHT -> from.x - (deviceInfo.widthGrid * 0.9f).toInt() to 0
+        }
+        (ensureOpen() as ChromeDriver).executeCdpCommand(
+            "Input.dispatchMouseEvent",
+            mapOf(
+                "type" to "mouseWheel",
+                "x" to from.x,
+                "y" to from.y,
+                "deltaX" to deltaX,
+                "deltaY" to deltaY,
+            )
+        )
+    }
+
     override fun isKeyboardVisible(): Boolean {
         return false
     }

