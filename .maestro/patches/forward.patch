From 6e9da7b7101cdbca615219a595a2c9c95e086ddc Mon Sep 17 00:00:00 2001
From: danilo neves cruz <cruzdanilo@gmail.com>
Date: Sat, 24 Oct 2026 23:44:55 +0000
Subject: [PATCH] feat: add forward key

Android has a forward key next to back, and browsers have a forward button, but pressKey had no way to press either, so flows could go back in history and never forward again. Add a Forward key: Android sends KEYCODE_FORWARD and web navigates forward in the browser history.
---
 maestro-client/src/main/java/maestro/KeyCode.kt              | 1 +
 .../src/main/java/maestro/drivers/AndroidDriver.kt           | 1 +
 maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt | 5 +++++
 maestro-client/src/main/java/maestro/drivers/WebDriver.kt    | 5 +++++
 maestro-test/src/test/kotlin/maestro/test/IntegrationTest.kt | 1 +
 maestro-test/src/test/resources/034_press_key.yaml           | 1 +
 6 files changed, 14 insertions(+)

diff --git a/maestro-client/src/main/java/maestro/KeyCode.kt b/maestro-client/src/main/java/maestro/KeyCode.kt
index 83c8f90..05e4bd5 100644
--- a/maestro-client/src/main/java/maestro/KeyCode.kt
+++ b/maestro-client/src/main/java/maestro/KeyCode.kt
@@ -15,6 +15,7 @@ enum class KeyCode(
     ENTER("Enter"),
     BACKSPACE("Backspace"),
     BACK("Back"),
+    FORWARD("Forward"),
     HOME("Home"),
     LOCK("Lock"),
     VOLUME_UP("Volume Up"),
diff --git a/maestro-client/src/main/java/maestro/drivers/AndroidDriver.kt b/maestro-client/src/main/java/maestro/drivers/AndroidDriver.kt
index 8211337..9cb36b5 100644
--- a/maestro-client/src/main/java/maestro/drivers/AndroidDriver.kt
+++ b/maestro-client/src/main/java/maestro/drivers/AndroidDriver.kt
@@ -290,6 +290,7 @@ class AndroidDriver(
                 KeyCode.ENTER -> 66
                 KeyCode.BACKSPACE -> 67
                 KeyCode.BACK -> 4
+                KeyCode.FORWARD -> 125
                 KeyCode.VOLUME_UP -> 24
                 KeyCode.VOLUME_DOWN -> 25
                 KeyCode.HOME -> 3
diff --git a/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt b/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt
index ad651bb..03a2485 100644
--- a/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt
+++ b/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt
@@ -479,6 +479,11 @@ class CdpWebDriver(
     }
 
     override fun pressKey(code: KeyCode) {
+        if (code == KeyCode.FORWARD) {
+            ensureOpen().navigate().forward()
+            return
+        }
+
         val key = mapToSeleniumKey(code)
         withActiveElement { it.sendKeys(key) }
     }
diff --git a/maestro-client/src/main/java/maestro/drivers/WebDriver.kt b/maestro-client/src/main/java/maestro/drivers/WebDriver.kt
index 5bd3ec7..9045f56 100644
--- a/maestro-client/src/main/java/maestro/drivers/WebDriver.kt
+++ b/maestro-client/src/main/java/maestro/drivers/WebDriver.kt
@@ -398,6 +398,11 @@ class WebDriver(
     }
 
     override fun pressKey(code: KeyCode) {
+        if (code == KeyCode.FORWARD) {
+            ensureOpen().navigate().forward()
+            return
+        }
+
         val key = mapToSeleniumKey(code)
         withActiveElement { element -> element.sendKeys(key) }
     }
diff --git a/maestro-test/src/test/kotlin/maestro/test/IntegrationTest.kt b/maestro-test/src/test/kotlin/maestro/test/IntegrationTest.kt
index fe342ab..740cc08 100644
--- a/maestro-test/src/test/kotlin/maestro/test/IntegrationTest.kt
+++ b/maestro-test/src/test/kotlin/maestro/test/IntegrationTest.kt
@@ -1109,6 +1109,7 @@ class IntegrationTest {
         driver.assertHasEvent(Event.PressKey(KeyCode.BACKSPACE))
         driver.assertHasEvent(Event.PressKey(KeyCode.HOME))
         driver.assertHasEvent(Event.PressKey(KeyCode.BACK))
+        driver.assertHasEvent(Event.PressKey(KeyCode.FORWARD))
         driver.assertHasEvent(Event.PressKey(KeyCode.VOLUME_UP))
         driver.assertHasEvent(Event.PressKey(KeyCode.VOLUME_DOWN))
         driver.assertHasEvent(Event.PressKey(KeyCode.LOCK))
diff --git a/maestro-test/src/test/resources/034_press_key.yaml b/maestro-test/src/test/resources/034_press_key.yaml
index 8d72550..5ef0f53 100644
--- a/maestro-test/src/test/resources/034_press_key.yaml
+++ b/maestro-test/src/test/resources/034_press_key.yaml
@@ -4,6 +4,7 @@ appId: com.example.app
 - pressKey: Backspace
 - pressKey: Home
 - pressKey: back
+- pressKey: Forward
 - pressKey: Volume Up
 - pressKey: volume Down
 - pressKey: lOcK
-- 
