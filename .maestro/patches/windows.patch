From b2777f0bf3d3eacb6d0258e237f4d9d4393b43d9 Mon Sep 17 00:00:00 2001
From: danilo neves cruz <cruzdanilo@gmail.com>
Date: Wed, 21 Oct 2026 18:51:54 +0000
Subject: [PATCH] fix: follow popup, extension and browser UI windows on web

detectWindowChange only switches to new window handles, so after a popup closes every later command fails on the closed window, and ChromeDriver hides chrome-extension:// tabs and popups from the handles, so an extension's own windows are never reached. Turn on ChromeDriver's enableExtensionTargets, switch only to page targets (extension service workers and offscreen documents become handles too), and when the current window closes, switch back to the window that opened it.

Popups that are part of the browser UI, such as the panel a browser's built-in wallet opens for a page's request, are browser_ui targets, which ChromeDriver hides too. Turn on its windowTypes for them and follow one while its document is visible. The browser keeps such a target after its popup closes, with the document hidden, so a hidden one counts as closed, and browser UI that stays hidden, such as the omnibox popup, is never followed. ChromeDriver crashes when a window that isn't a tab closes during one of its commands (WebViewImplHolder checks for a page tracker, which only tabs have), and such a popup closes on the click that answers it, so in a browser UI window taps, key presses and the current URL go over Maestro's own CDP connection to the target, like scripts and screenshots. The click or key press that answers such a popup can close it before the browser acknowledges it, so input whose window closed counts as done.

The window the session starts in is seen from the start. It used to count as a new window on the first command, so a window opened before then was never followed: both were new at once, and the first one won.

Commands that run while a window closes no longer fail on it: reading the current URL is skipped, and a JS evaluation whose target is gone is retried against the next one.
---
 .../main/java/maestro/drivers/CdpWebDriver.kt | 80 +++++++++++++++----
 .../main/kotlin/maestro/web/cdp/CdpClient.kt  | 17 ++++
 2 files changed, 81 insertions(+), 16 deletions(-)

diff --git a/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt b/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt
index 5ae9d58..27425ff 100644
--- a/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt
+++ b/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt
@@ -99,6 +99,9 @@ class CdpWebDriver(
     internal var seleniumDriver: org.openqa.selenium.WebDriver? = null
     private var maestroWebScript: String? = null
     private var lastSeenWindowHandles = setOf<String>()
+    private val openerHandles = mutableListOf<String>()
+    private val browserUiHandles = mutableSetOf<String>()
+    private var currentWindow: String? = null
     private var injectedArguments: Map<String, Any> = emptyMap()
 
     private var webScreenRecorder: WebScreenRecorder? = null
@@ -117,6 +120,8 @@ class CdpWebDriver(
 
     override fun open() {
         seleniumDriver = createSeleniumDriver()
+        currentWindow = seleniumDriver?.windowHandle
+        lastSeenWindowHandles = setOfNotNull(currentWindow)
 
         try {
             seleniumDriver
@@ -161,6 +166,8 @@ class CdpWebDriver(
                 setExperimentalOption("prefs", chromePrefs)
 
                 setExperimentalOption("detach", true)
+                setExperimentalOption("enableExtensionTargets", true)
+                setExperimentalOption("windowTypes", listOf(BROWSER_UI_TARGET_TYPE))
 
                 if (isHeadless) {
                     addArguments("--headless=new")
@@ -264,7 +271,10 @@ class CdpWebDriver(
     private fun isRetryableJsError(e: Exception): Boolean {
         val message = e.message ?: return false
         return message.contains("getContentDescription") ||
-            message.contains("navigated or closed")
+            message.contains("navigated or closed") ||
+            message.contains("Handshake exception") ||
+            message.contains("No message with id") ||
+            message.contains("Channel was cancelled")
     }
 
     private fun scrollToPoint(point: Point): Long {
@@ -303,6 +313,9 @@ class CdpWebDriver(
 
         seleniumDriver = null
         lastSeenWindowHandles = setOf()
+        openerHandles.clear()
+        browserUiHandles.clear()
+        currentWindow = null
         webScreenRecorder = null
     }
 
@@ -398,7 +411,7 @@ class CdpWebDriver(
         val rawMap = contentDesc as Map<String, Any>
         val enrichedMap = injectCrossOriginIframes(rawMap)
         val root = parseDomAsTreeNodes(enrichedMap)
-        seleniumDriver?.currentUrl?.let { url ->
+        runCatching { if (inBrowserUi()) runBlocking { currentTarget().url } else seleniumDriver?.currentUrl }.getOrNull()?.let { url ->
             root.attributes["url"] = url
         }
         return root
@@ -438,15 +451,32 @@ class CdpWebDriver(
         // Checks whether there are any new window handles available and, if so, switches Selenium driver focus to it
         val driver = ensureOpen()
 
-        if (lastSeenWindowHandles != driver.windowHandles) {
-            val newHandles = driver.windowHandles - lastSeenWindowHandles
-            lastSeenWindowHandles = driver.windowHandles
-
-            if (newHandles.isNotEmpty()) {
-                val newHandle = newHandles.first()
-                LOGGER.info("Detected a window change, switching to new window handle $newHandle")
+        val handles = driver.windowHandles
+        val targets by lazy { runBlocking { cdpClient.listTargets() } }
+        val current = currentWindow?.takeIf { it in handles }
+        val currentHandle = current.takeUnless { handle ->
+            handle in browserUiHandles && targets.none { it.id == handle && isVisible(it) }
+        }
+        if (lastSeenWindowHandles != handles || currentHandle != current) {
+            val windows = targets
+                .filter { it.type == PAGE_TARGET_TYPE || it.type == BROWSER_UI_TARGET_TYPE && isVisible(it) }
+                .associateBy { it.id }
+            val newHandles = (handles - lastSeenWindowHandles).filter { it in windows }
+            lastSeenWindowHandles = handles
+            if (newHandles.isNotEmpty()) currentHandle?.let { openerHandles.add(it) }
+            openerHandles.retainAll(lastSeenWindowHandles)
+            browserUiHandles.retainAll(lastSeenWindowHandles)
+
+            val newHandle = newHandles.firstOrNull()
+                ?: (openerHandles.lastOrNull() ?: lastSeenWindowHandles.firstOrNull { windows[it]?.type == PAGE_TARGET_TYPE })
+                    .takeIf { currentHandle == null }
+            if (newHandle != null) {
+                openerHandles.remove(newHandle)
+                if (windows[newHandle]?.type == BROWSER_UI_TARGET_TYPE) browserUiHandles.add(newHandle)
+                LOGGER.info("Detected a window change, switching to window handle $newHandle")
 
                 driver.switchTo().window(newHandle)
+                currentWindow = newHandle
 
                 try {
                     webScreenRecorder?.onWindowChange()
@@ -460,6 +490,11 @@ class CdpWebDriver(
         }
     }
 
+    private fun inBrowserUi() = currentWindow in browserUiHandles
+
+    private fun isVisible(target: CdpTarget) =
+        runCatching { runBlocking { cdpClient.evaluate("document.visibilityState", target) } }.getOrNull() == "\"visible\""
+
     override fun clearAppState(appId: String) {
         ensureOpen()
 
@@ -495,7 +530,7 @@ class CdpWebDriver(
     }
 
     override fun tap(point: Point) {
-        val driver = ensureOpen() as ChromeDriver
+        ensureOpen()
 
         if (point.x >= SYNTHETIC_COORDINATE_SPACE_OFFSET && point.y >= SYNTHETIC_COORDINATE_SPACE_OFFSET) {
             tapOnSyntheticCoordinateSpace(point)
@@ -504,9 +539,9 @@ class CdpWebDriver(
 
         val pixelsScrolled = scrollToPoint(point)
 
-        for (type in listOf("mouseMoved", "mousePressed", "mouseReleased")) {
-            driver.executeCdpCommand(
-                "Input.dispatchMouseEvent",
+        dispatchInputEvents(
+            "Input.dispatchMouseEvent",
+            listOf("mouseMoved", "mousePressed", "mouseReleased").map { type ->
                 mapOf(
                     "type" to type,
                     "x" to point.x,
@@ -514,7 +549,20 @@ class CdpWebDriver(
                     "button" to if (type == "mouseMoved") "none" else "left",
                     "clickCount" to 1,
                 )
-            )
+            },
+        )
+    }
+
+    private fun dispatchInputEvents(method: String, events: List<Map<String, Any>>) {
+        val driver = ensureOpen() as ChromeDriver
+        if (!inBrowserUi()) return events.forEach { driver.executeCdpCommand(method, it) }
+
+        runBlocking {
+            val target = currentTarget()
+            for (event in events) {
+                runCatching { cdpClient.dispatchInputEvent(method, event, target) }
+                    .onFailure { if (cdpClient.listTargets().any { it.id == target.id && isVisible(it) }) throw it }
+            }
         }
     }
 
@@ -566,8 +614,7 @@ class CdpWebDriver(
             key - "text" + ("type" to "keyUp"),
             if (shift) SHIFT_KEY + ("type" to "keyUp") else null,
         )
-        val driver = ensureOpen() as ChromeDriver
-        for (event in events) driver.executeCdpCommand("Input.dispatchKeyEvent", event)
+        dispatchInputEvents("Input.dispatchKeyEvent", events)
     }
 
     override fun scrollVertical() {
@@ -1003,6 +1050,7 @@ class CdpWebDriver(
         // The only /json target type that is a real tab; everything else is a browser surface,
         // an extension worker or an iframe.
         private const val PAGE_TARGET_TYPE = "page"
+        private const val BROWSER_UI_TARGET_TYPE = "browser_ui"
 
         private val BROWSER_INTERNAL_URL_SCHEMES =
             listOf("chrome://", "chrome-untrusted://", "chrome-extension://", "devtools://")
diff --git a/maestro-web/src/main/kotlin/maestro/web/cdp/CdpClient.kt b/maestro-web/src/main/kotlin/maestro/web/cdp/CdpClient.kt
index ca78c8e..e8ff77d 100644
--- a/maestro-web/src/main/kotlin/maestro/web/cdp/CdpClient.kt
+++ b/maestro-web/src/main/kotlin/maestro/web/cdp/CdpClient.kt
@@ -159,6 +159,23 @@ class CdpClient(
         }
     }
 
+    suspend fun dispatchInputEvent(method: String, params: Map<String, Any>, target: CdpTarget) {
+        val messageId = idCounter.getAndIncrement()
+        val payload = JsonObject(
+            mapOf(
+                "id" to JsonPrimitive(messageId),
+                "method" to JsonPrimitive(method),
+                "params" to JsonObject(params.mapValues { (_, value) -> if (value is Number) JsonPrimitive(value) else JsonPrimitive("$value") }),
+            )
+        )
+
+        withSession(target.webSocketDebuggerUrl ?: error("Target ${target.id} has no WebSocket debugger URL")) { session ->
+            session.send(Frame.Text(payload.toString()))
+
+            session.waitForMessage(messageId)
+        }
+    }
+
     suspend fun clearDataForOrigin(origin: String, storageTypes: String, target: CdpTarget) {
         val messageId = idCounter.getAndIncrement()
         val originJson = Json.encodeToString(JsonPrimitive(origin))
