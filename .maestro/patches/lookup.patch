+package maestro.drivers
+
+import com.google.common.truth.Truth.assertThat
+import kotlinx.coroutines.runBlocking
+import maestro.Maestro
+import maestro.OnDeviceElementQuery
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable
+import org.openqa.selenium.JavascriptExecutor
+import org.openqa.selenium.Dimension
+
+@EnabledIfEnvironmentVariable(named = "MAESTRO_TEST_BROWSER", matches = "true")
+class CdpLookupBrowserTest {
+    private val driver = CdpWebDriver(isStudio = false, isHeadless = true, screenSize = "800x600", browserArgs = listOf("--no-sandbox"))
+    private val browser get() = driver.seleniumDriver as JavascriptExecutor
+
+    @BeforeEach
+    fun setUp() {
+        driver.open()
+        driver.seleniumDriver!!.get("data:text/html,<body><button>ready</button></body>")
+    }
+
+    @AfterEach
+    fun tearDown() {
+        driver.close()
+    }
+
+    @Test
+    fun `hierarchy survives a temporarily missing document body`() {
+        browser.executeScript("const body = document.body; body.remove(); setTimeout(() => document.documentElement.append(body), 800)")
+
+        assertThat(driver.contentDescriptor().aggregate().map { it.attributes["text"] }).contains("ready")
+    }
+
+    @Test
+    fun `permanently missing body fails within the recovery bound`() {
+        browser.executeScript("document.body.remove()")
+        val start = System.nanoTime()
+
+        assertThrows<IllegalStateException> { driver.contentDescriptor() }
+
+        assertThat((System.nanoTime() - start) / 1_000_000).isAtLeast(1000)
+        assertThat((System.nanoTime() - start) / 1_000_000).isLessThan(5000)
+    }
+
+    @Test
+    fun `hierarchy lookup sees a delayed element`() = runBlocking {
+        browser.executeScript("document.body.textContent = ''; setTimeout(() => document.body.innerHTML = '<button>late</button>', 800)")
+
+        val result = Maestro(driver).findElementWithTimeout(3000, { nodes -> nodes.filter { it.attributes["text"] == "late" } })
+
+        assertThat(result).isNotNull()
+    }
+
+    @Test
+    fun `css lookup sees a delayed element`() = runBlocking {
+        browser.executeScript("document.body.textContent = ''; setTimeout(() => document.body.innerHTML = '<button>late</button>', 800)")
+
+        val result = Maestro(driver).findElementsByOnDeviceQuery(3000, OnDeviceElementQuery.Css("button"))
+
+        assertThat(result?.elements).hasSize(1)
+    }
+
+    @Test
+    fun `viewport reads reflect browser resizing`() {
+        val before = driver.deviceInfo()
+        driver.seleniumDriver!!.manage().window().size = Dimension(1000, 700)
+
+        val after = driver.deviceInfo()
+
+        assertThat(after.widthPixels).isGreaterThan(before.widthPixels)
+        assertThat(after.heightPixels).isGreaterThan(before.heightPixels)
+    }
+}
diff --git a/maestro-client/src/test/java/maestro/drivers/CdpLookupTest.kt b/maestro-client/src/test/java/maestro/drivers/CdpLookupTest.kt
