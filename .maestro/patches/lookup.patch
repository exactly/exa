@@ -0,0 +1,124 @@
+package maestro.drivers
+
+import CdpClient
+import CdpTarget
+import com.google.common.truth.Truth.assertThat
+import io.mockk.coEvery
+import io.mockk.coVerify
+import io.mockk.every
+import io.mockk.mockk
+import kotlinx.coroutines.runBlocking
+import maestro.Maestro
+import maestro.OnDeviceElementQuery
+import maestro.utils.MaestroTimer
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import org.openqa.selenium.WebDriver
+
+class CdpLookupTest {
+    private val driver = CdpWebDriver(isStudio = false, isHeadless = true, screenSize = null)
+    private val client = mockk<CdpClient>()
+    private val timer = MaestroTimer.sleep
+    private var elapsed = 0L
+    private val reads = mutableListOf<Long>()
+    private val hierarchy = """{"attributes":{"text":"ready","bounds":"[0,0][100,100]"},"children":[]}"""
+
+    @BeforeEach
+    fun setUp() {
+        val selenium = mockk<WebDriver>(relaxed = true)
+        every { selenium.windowHandles } returns setOf("page")
+        every { selenium.windowHandle } returns "page"
+        driver.seleniumDriver = selenium
+        CdpWebDriver::class.java.getDeclaredField("cdpClient").apply {
+            isAccessible = true
+            set(driver, client)
+        }
+        coEvery { client.listTargets() } returns listOf(CdpTarget("page", "page", "http://localhost", "page", "ws://localhost"))
+        coEvery { client.evaluate(any(), any()) } returns "null"
+        coEvery { client.evaluate("window.innerWidth", any()) } returns "100"
+        coEvery { client.evaluate("window.innerHeight", any()) } returns "100"
+        MaestroTimer.setTimerFunc { _, duration -> elapsed += duration }
+    }
+
+    @AfterEach
+    fun tearDown() {
+        MaestroTimer.setTimerFunc(timer)
+    }
+
+    @Test
+    fun `viewport reads add no delay and reflect a resize`() {
+        assertThat(driver.deviceInfo().widthPixels).isEqualTo(100)
+        coEvery { client.evaluate("window.innerWidth", any()) } returns "200"
+        assertThat(driver.deviceInfo().widthPixels).isEqualTo(200)
+        assertThat(elapsed).isEqualTo(0)
+    }
+
+    @Test
+    fun `missing document can recover on the tenth paced hierarchy read`() {
+        coEvery { client.evaluate("window.maestro.getContentDescription()", any()) } answers {
+            reads.add(elapsed)
+            if (elapsed < 1000) "null" else hierarchy
+        }
+
+        assertThat(driver.contentDescriptor().attributes["text"]).isEqualTo("ready")
+        assertThat(reads).containsExactlyElementsIn((100L..1000L step 100).toList()).inOrder()
+    }
+
+    @Test
+    fun `lost execution context retains the hierarchy recovery window`() {
+        coEvery { client.evaluate("window.maestro.getContentDescription()", any()) } answers {
+            reads.add(elapsed)
+            if (elapsed < 800) error("Cannot find context with specified id") else hierarchy
+        }
+
+        assertThat(driver.contentDescriptor().attributes["text"]).isEqualTo("ready")
+        assertThat(reads).containsExactlyElementsIn((100L..800L step 100).toList()).inOrder()
+    }
+
+    @Test
+    fun `unavailable document exhausts the existing bounded recovery window`() {
+        assertThrows<IllegalStateException> { driver.contentDescriptor() }
+        assertThat(elapsed).isEqualTo(1000)
+        coVerify(exactly = 10) { client.evaluate("window.maestro.getContentDescription()", any()) }
+    }
+
+    @Test
+    fun `failed hierarchy matches keep yielding between DOM traversals`() = runBlocking {
+        coEvery { client.evaluate("window.maestro.getContentDescription()", any()) } answers {
+            reads.add(elapsed)
+            hierarchy
+        }
+        val found = Maestro(driver).findElementWithTimeout(1000, { nodes ->
+            if (reads.size == 3) nodes else emptyList()
+        })
+
+        assertThat(found).isNotNull()
+        assertThat(reads).containsExactly(100L, 200L, 300L).inOrder()
+    }
+
+    @Test
+    fun `failed css matches keep yielding between DOM queries`() = runBlocking {
+        coEvery { client.evaluate("window.maestro.queryCss(\"button\")", any()) } answers {
+            reads.add(elapsed)
+            if (reads.size == 3) "[$hierarchy]" else "[]"
+        }
+        val found = Maestro(driver).findElementsByOnDeviceQuery(1000, OnDeviceElementQuery.Css("button"))
+
+        assertThat(found?.elements).hasSize(1)
+        assertThat(reads).containsExactly(100L, 200L, 300L).inOrder()
+    }
+
+    @Test
+    fun `settling keeps three hundred milliseconds per hierarchy sample`() {
+        coEvery { client.evaluate("window.maestro.getContentDescription()", any()) } answers {
+            reads.add(elapsed)
+            hierarchy
+        }
+
+        driver.waitForAppToSettle(null, null, null)
+
+        assertThat(reads).containsExactly(300L, 600L).inOrder()
+    }
+}
