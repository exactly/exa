From bb99302bd49486c0ac9d4245f20a812b28b8fa13 Mon Sep 17 00:00:00 2001
From: danilo neves cruz <cruzdanilo@gmail.com>
Date: Wed, 21 Oct 2026 18:52:08 +0000
Subject: [PATCH] fix: tap web elements with CDP mouse events

ChromeDriver's pointer actions run script in the page's main world, so a tap fails on any page that locks down its globals, such as an extension popup under LavaMoat ("property \"Window\" of globalThis is inaccessible under scuttling mode"). Send the tap as mouseMoved, mousePressed and mouseReleased CDP input events instead, like swipes, which run no page script.
---
 .../main/java/maestro/drivers/CdpWebDriver.kt | 24 +++++++++----------
 1 file changed, 11 insertions(+), 13 deletions(-)

diff --git a/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt b/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt
index 80a8859..5ae9d58 100644
--- a/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt
+++ b/maestro-client/src/main/java/maestro/drivers/CdpWebDriver.kt
@@ -495,7 +495,7 @@ class CdpWebDriver(
     }
 
     override fun tap(point: Point) {
-        val driver = ensureOpen()
+        val driver = ensureOpen() as ChromeDriver
 
         if (point.x >= SYNTHETIC_COORDINATE_SPACE_OFFSET && point.y >= SYNTHETIC_COORDINATE_SPACE_OFFSET) {
             tapOnSyntheticCoordinateSpace(point)
@@ -504,20 +504,18 @@ class CdpWebDriver(
 
         val pixelsScrolled = scrollToPoint(point)
 
-        val mouse = PointerInput(PointerInput.Kind.MOUSE, "default mouse")
-        val actions = Sequence(mouse, 1)
-            .addAction(
-                mouse.createPointerMove(
-                    Duration.ofMillis(400),
-                    PointerInput.Origin.viewport(),
-                    point.x,
-                    point.y - pixelsScrolled.toInt()
+        for (type in listOf("mouseMoved", "mousePressed", "mouseReleased")) {
+            driver.executeCdpCommand(
+                "Input.dispatchMouseEvent",
+                mapOf(
+                    "type" to type,
+                    "x" to point.x,
+                    "y" to point.y - pixelsScrolled.toInt(),
+                    "button" to if (type == "mouseMoved") "none" else "left",
+                    "clickCount" to 1,
                 )
             )
-
-        (driver as RemoteWebDriver).perform(listOf(actions))
-
-        Actions(driver).click().build().perform()
+        }
     }
 
     private fun tapOnSyntheticCoordinateSpace(point: Point) {
-- 
