From 4ac83c69af106ee07c27892ca1296e5970fd7841 Mon Sep 17 00:00:00 2001
From: danilo neves cruz <cruzdanilo@gmail.com>
Date: Tue, 20 Oct 2026 00:51:30 +0000
Subject: [PATCH 2/2] fix: reuse one CDP websocket per target

CdpClient opened and closed a websocket for every evaluate, screenshot, navigation and storage call. Every detach makes Chrome disable the page's WebAuthn domain, which erases its virtual authenticators, and every extra handshake is another chance for the call to drop. Keep one session per target and reconnect only when it is no longer active.
---
 .../main/kotlin/maestro/web/cdp/CdpClient.kt  | 64 +++++++++----------
 1 file changed, 32 insertions(+), 32 deletions(-)

diff --git a/maestro-web/src/main/kotlin/maestro/web/cdp/CdpClient.kt b/maestro-web/src/main/kotlin/maestro/web/cdp/CdpClient.kt
index 2e8c50d..e8696d9 100644
--- a/maestro-web/src/main/kotlin/maestro/web/cdp/CdpClient.kt
+++ b/maestro-web/src/main/kotlin/maestro/web/cdp/CdpClient.kt
@@ -6,6 +6,7 @@ import io.ktor.client.request.*
 import io.ktor.client.statement.*
 import io.ktor.serialization.kotlinx.json.*
 import io.ktor.websocket.*
