+    override fun enrollBiometrics() {
+        LOGGER.warn("Enrolling biometrics is not available on Android, enroll a fingerprint in the emulator's settings instead")
+    }
+
+    override fun matchBiometrics() {
+        metrics.measured("operation", mapOf("command" to "matchBiometrics")) {
+            val process = ProcessBuilder("adb", "-s", connection.serial, "emu", "finger", "touch", "1")
+                .redirectErrorStream(true)
+                .start()
+            if (!process.waitFor(1, TimeUnit.MINUTES)) {
+                throw TimeoutException("Matching biometrics on ${connection.serial} timed out")
+            }
+            if (process.exitValue() != 0) {
+                throw IllegalStateException("Failed to match biometrics on ${connection.serial}: ${process.inputStream.bufferedReader().readText()}")
+            }
+        }
+    }
