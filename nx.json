{
  "extends": "nx/presets/npm.json",
  "cli": { "packageManager": "pnpm" },
  "tasksRunnerOptions": { "default": "nx/tasks-runners/default" },
  "plugins": ["./common/nx.ts", { "plugin": "@nx/eslint/plugin", "options": { "targetName": "test:eslint" } }],
  "pluginsConfig": { "@nx/js": { "analyzeSourceFiles": false } },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/generated/**/*",
      "!{projectRoot}/broadcast/*/31337/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/AGENTS.md"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ]
  },
  "targetDefaults": {
    "generate:*": { "inputs": ["production", "^production"], "cache": true },
    "prepare": { "dependsOn": ["^prepare"] },
    "test": { "dependsOn": ["prepare", "^prepare"], "cache": true },
    "test:*": { "dependsOn": ["prepare", "^prepare"], "cache": true },
    "test:ts": {
      "dependsOn": ["prepare", "^prepare"],
      "cache": true,
      "outputs": ["{workspaceRoot}/.cache/typescript/{projectRoot}/tsconfig.tsbuildinfo"]
    },
    "test:eslint": { "dependsOn": ["prepare", "^prepare"], "cache": true, "options": { "max-warnings": 0 } },
    "build": {
      "dependsOn": ["^prepare"],
      "inputs": [
        "production",
        { "dependentTasksOutputFiles": "{common,src}/generated/**/*", "transitive": true },
        "^production"
      ],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    }
  },
  "analytics": false,
  "neverConnectToCloud": true,
  "tui": { "autoExit": true }
}
